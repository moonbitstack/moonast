// filled by replacing nodes, and printed back by its formatter, so quoting,
// escaping and layout are the official ones.
import {
  "moonbitlang/parser",
  "moonbitlang/parser/syntax",
  "moonbitlang/parser/fmt",
  "moonbitlang/core/list",
}
