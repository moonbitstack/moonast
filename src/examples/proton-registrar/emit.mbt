///|
/// The registrar for one package: `register_commands` binds the package's own
/// commands in the order they are declared, then one such function for each type
/// that has method commands, in the order those types first appear.
fn emit(commands : Array[Command]) -> @quote.Code raise {
  let groups : Array[(String?, Array[Command])] = []
  let free = commands.filter(command => command.receiver is None)
  if !free.is_empty() {
    groups.push((None, free))
  }
  let receivers = []
  for command in commands {
    match command.receiver {
      Some(receiver) if !receivers.contains(receiver) =>
        receivers.push(receiver)
      _ => ()
    }
  }
  for receiver in receivers {
    groups.push(
      (
        Some(receiver),
        commands.filter(command => command.receiver == Some(receiver)),
      ),
    )
  }
  let out = []
  for index, group in groups {
    let (receiver, members) = group
    out.push(registrar(receiver, members, first=index == 0))
  }
  @quote.join(out)
}

///|
/// The header every file of this generator opens with. It is a doc comment on the
/// first declaration rather than a `//` line, which the printer drops: a file of
/// generated code should say so.
fn header() -> String {
  "/// Generated by `proton_codegen`. Do not edit by hand.\n"
}

///|
/// Fill `$s0`, `$s1`, … with what the structure leaves open, in the order they
/// appear.
fn code(source : String, fills : Array[@quote.Code]) -> @quote.Code raise {
  let mut template = @quote.items(source)
  for i, fill in fills {
    template = template.set("s\{i}", fill)
  }
  template.render()
}

///|
/// One `register_commands`: `None` for the package's own commands, `Some(type)`
/// for that type's methods.
fn registrar(
  receiver : String?,
  commands : Array[Command],
  first~ : Bool,
) -> @quote.Code raise {
  let out = StringBuilder()
  if first {
    out.write_string(header())
  }
  match receiver {
    Some(receiver) =>
      out.write_string(
        "pub fn \{receiver}::register_commands(\n  self : \{receiver},\n  registrar : @proton.CommandRegistrar,\n) -> Unit raise {\n",
      )
    None =>
      out.write_string(
        "pub fn register_commands(\n  registrar : @proton.CommandRegistrar,\n) -> Unit raise {\n",
      )
  }
  for command in commands {
    // A handler that takes no context, or no request, still has to fill the
    // parameter: the registrar calls every handler with both.
    let context = if command.context { "context" } else { "_context" }
    let request = if command.request { "request" } else { "_request" }
    let qualifier = match command.receiver {
      Some(_) => "self."
      None => ""
    }
    let given = []
    if command.context {
      given.push("context")
    }
    if command.request {
      given.push("request")
    }
    out.write_string(
      "  registrar.bind(\n    \{command.contract},\n    (\{context}, \{request}) => \{qualifier}\{command.name}(\{given.join(", ")}),\n  )\n",
    )
  }
  out.write_string("}\n")
  code(out.to_string(), [])
}
