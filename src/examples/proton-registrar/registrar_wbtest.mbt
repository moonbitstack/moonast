///|
fn without_separators(text : String) -> String {
  text.split("\n").filter(line => line != "///|").collect().join("\n")
}

///|
async test "the registrar is the one the community project's generator writes" {
  let path = "src/examples/proton-registrar/fixtures/commands.mbt"
  let generated = @gen.render(Registrar::{ }, [
    (path, @fs.read_file(path).text()),
  ])
  let expected = @quote.items(
    without_separators(
      @fs.read_file("src/examples/proton-registrar/fixtures/expected.g.mbt").text(),
    ),
  ).render()
  // Generated by proton-registrar from commands.mbt. Edit those files, not this one.
  let header = "// Generated by proton-registrar from commands.mbt. Edit those files, not this one.\n\n"
  assert_eq(generated, header + expected.to_string())
}

///|
test "a function without the annotation is not a command" {
  let decls = @gen.read("m.mbt", "pub fn f() -> Unit { () }")
  assert_eq(commands_of(decls).length(), 0)
}

///|
test "context and request are read off the parameters" {
  let source =
    #|#proton.command(contract=a)
    #|fn one() -> Unit { () }
    #|
    #|#proton.command(contract=b)
    #|fn two(context : @proton.CommandContext) -> Unit { ignore(context) }
  let commands = commands_of(@gen.read("m.mbt", source))
  assert_eq(commands.map(c => (c.name, c.context, c.request)), [
    ("one", false, false),
    ("two", true, false),
  ])
}

///|
test "a method command keeps its receiver" {
  let source =
    #|#proton.command(contract=create)
    #|fn Registry::create(self : Registry, request : Create) -> Unit { ignore((self, request)) }
  guard commands_of(@gen.read("m.mbt", source)) is [command] else {
    fail("one command")
  }
  assert_eq(command.receiver, Some("Registry"))
  assert_eq(command.request, true)
}

///|
test "two commands on one contract are refused" {
  let source =
    #|#proton.command(contract=shared)
    #|fn one() -> Unit { () }
    #|
    #|#proton.command(contract=shared)
    #|fn two() -> Unit { () }
  let refused = try commands_of(@gen.read("m.mbt", source)) catch {
    e => e.to_string()
  } noraise {
    _ => ""
  }
  assert_eq(refused, "<inputs>: `one` and `two` are both bound to shared")
}
