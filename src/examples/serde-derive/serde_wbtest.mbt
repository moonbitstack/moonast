///|
/// The file the generator writes, with the one-line header `moonast/cli` puts above
/// the code it renders.
async fn rendered(path : String) -> String {
  @gen.render(Derive::{ }, [(path, @fs.read_file(path).text())])
}

///|
/// `///|` is the separator the printer puts before every declaration, and it puts
/// an empty `///` after one that is already there. Comparing text the printer
/// wrote with text that has them already would compare that artefact, so the
/// expected side goes in without them.
fn without_separators(text : String) -> String {
  text.split("\n").filter(line => line != "///|").collect().join("\n")
}

///|
async test "the generated file is the one the community project's derive writes" {
  let path = "src/examples/serde-derive/fixtures/models.mbt"
  let generated = rendered(path)
  let expected = @quote.items(
    without_separators(
      @fs.read_file("src/examples/serde-derive/fixtures/expected.g.mbt").text(),
    ),
  ).render()
  // Generated by serde-derive from models.mbt. Edit those files, not this one.
  let header = "// Generated by serde-derive from models.mbt. Edit those files, not this one.\n\n"
  assert_eq(generated, header + expected.to_string())
}

///|
test "a type with nothing marked for it is not a target" {
  let decls = @gen.read("m.mbt", "pub struct Point {\n  x : Int\n}")
  assert_eq(targets_of(decls).length(), 0)
}

///|
test "one trait is enough to ask for" {
  let decls = @gen.read(
    "m.mbt", "#serde.derive(Serialize)\npub struct P {\n  x : Int\n}",
  )
  guard targets_of(decls) is [target] else { fail("one target") }
  assert_eq(target.serialize, true)
  assert_eq(target.deserialize, false)
}

///|
test "a trait the derive does not write is refused, naming the type" {
  let decls = @gen.read(
    "m.mbt", "#serde.derive(Hash)\npub struct P {\n  x : Int\n}",
  )
  let refused = try targets_of(decls) catch {
    e => e.to_string()
  } noraise {
    _ => ""
  }
  assert_eq(
    refused, "m.mbt:1:1: cannot derive `Hash`; expected Serialize or Deserialize",
  )
}

///|
test "two fields under one wire name are refused" {
  let source =
    #|#serde.derive(Serialize)
    #|pub struct P {
    #|  #serde.rename("x")
    #|  a : Int
    #|  #serde.rename("x")
    #|  b : Int
    #|}
  let refused = try targets_of(@gen.read("m.mbt", source)) catch {
    e => e.to_string()
  } noraise {
    _ => ""
  }
  assert_eq(refused, "m.mbt:1:1: fields `a` and `b` both serialize as `x`")
}

///|
test "an annotation the derive does not know is refused rather than passed over" {
  let decls = @gen.read("m.mbt", "#serde.flatten\npub struct P {\n  x : Int\n}")
  let refused = try targets_of(decls) catch {
    e => e.to_string()
  } noraise {
    _ => ""
  }
  assert_eq(refused, "m.mbt:1:1: unknown annotation `#serde.flatten` on a type")
}
