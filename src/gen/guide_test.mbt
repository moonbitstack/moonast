///|
/// A registrar, the shape the guide uses for its last step: every annotated
/// function becomes one line of a table.
struct GuideRoute {}

///|
impl @gen.Generator for GuideRoute with fn name(_) {
  "route"
}

///|
impl @gen.Generator for GuideRoute with fn generate(_, decls) {
  let out = []
  for decl in decls {
    guard decl is Func(name~, attrs~, ..) else { continue }
    guard @attr.find(attrs, "app.route") is Some(annotation) else { continue }
    let args = @attr.Spec::new("app.route")
      .positional("path", Str)
      .many("tag", Str)
      .bind(annotation)
    let path = args.str("path").unwrap_or("/")
    let tags = args.strs("tag")
    let source =
      #|fn $reg(router : Router) -> Unit {
      #|  router.add($path, $handler, [$tags*])
      #|}
    out.push(
      @quote.items(source)
      .set("reg", @quote.ident("register_" + name))
      .set("path", @quote.string(path))
      .set("handler", @quote.ident(name))
      .splice("tags", tags.map(t => @quote.string(t)))
      .render(),
    )
  }
  @quote.join(out)
}

///|
let guide_routes : String =
  #|#app.route("/users", tag="users", tag="public")
  #|pub fn list_users() -> Array[String] {
  #|  []
  #|}
  #|
  #|#app.route("/users", tag="users")
  #|pub fn create_user(name : String) -> Unit {
  #|  ignore(name)
  #|}

///|
test "the file the guide's registrar writes" {
  inspect(
    @gen.render(GuideRoute::{ }, [("routes.mbt", guide_routes)]),
    content=(
      #|// Generated by route from routes.mbt. Edit those files, not this one.
      #|
      #|///|
      #|fn register_list_users(router : Router) -> Unit {
      #|  router.add("/users", list_users, ["users", "public"])
      #|}
      #|
      #|///|
      #|fn register_create_user(router : Router) -> Unit {
      #|  router.add("/users", create_user, ["users"])
      #|}
      #|
    ),
  )
}

///|
test "two inputs are both named in the header" {
  let out = @gen.render(GuideRoute::{ }, [
    ("a.mbt", guide_routes),
    ("b.mbt", guide_routes),
  ])
  inspect(
    out.split("\n").head().unwrap_or(""),
    content="// Generated by route from a.mbt, b.mbt. Edit those files, not this one.",
  )
}

///|
test "a run that matches nothing writes the header and nothing under it" {
  inspect(
    @gen.render(GuideRoute::{ }, [("routes.mbt", "pub fn f() -> Unit { () }\n")]),
    content="// Generated by route from routes.mbt. Edit those files, not this one.\n\n",
  )
}

///|
test "the lines the guide's walkthrough prints" {
  let source =
    #|#demo.describe
    #|pub struct Point {
    #|  x : Int
    #|  y : Int
    #|}
    #|
    #|pub enum Color {
    #|  Red
    #|  Green
    #|  Blue
    #|}
    #|
    #|pub fn dist(a : Point, b : Point, scale~ : Double) -> Double {
    #|  0.0
    #|}
  let lines = @gen.read("models.mbt", source).map(decl => {
    match decl {
      Struct(name~, fields~, ..) =>
        "struct " +
        name +
        " " +
        fields.map(f => f.name + ": " + f.ty).join(", ")
      Enum(name~, constructors~, ..) =>
        "enum " + name + " " + constructors.join(" | ")
      Func(owner~, name~, params~, returns~, ..) =>
        "func " +
        owner.unwrap_or("-") +
        "::" +
        name +
        " " +
        params.map(p => p.name.unwrap_or("_")).join(", ") +
        " -> " +
        returns.unwrap_or("Unit")
      Other(..) => "other"
    }
  })
  inspect(
    lines.join("\n"),
    content=(
      #|struct Point x: Int, y: Int
      #|enum Color Red | Green | Blue
      #|func -::dist a, b, scale -> Double
    ),
  )
}

///|
test "a method written fn Type::name arrives with its owner" {
  let source =
    #|fn Point::norm(self : Point) -> Double {
    #|  0.0
    #|}
  guard @gen.read("p.mbt", source) is [Func(owner~, name~, ..)] else {
    fail("one function")
  }
  inspect(owner.unwrap_or("-") + "::" + name, content="Point::norm")
}

///|
test "an input that is not MoonBit is refused with file, line and column" {
  let refused = try {
    let _ = @gen.render(GuideRoute::{ }, [("bad.mbt", "fn f( -> Unit { }")])
    "rendered"
  } catch {
    e => e.to_string()
  }
  inspect(
    refused.contains("bad.mbt:1:7: Unexpected token `->`"),
    content="true",
  )
}
