///|
/// A generator: given every declaration of its input files, the code to write.
/// One call sees all of them, so a derive can answer per declaration and a
/// registrar can gather every annotated function into one table.
pub(open) trait Generator {
  /// Short and stable: it goes in the header of every file it writes.
  fn name(Self) -> String
  /// Every declaration of the inputs, in one call: the code to write for all of them.
  fn generate(Self, Array[Decl]) -> @quote.Code raise
}

///|
/// The file a generator writes for `inputs`: a one-line header naming the
/// generator and the inputs, then the code. The same inputs give the same bytes,
/// so a check can compare them.
pub fn render(
  generator : &Generator,
  inputs : Array[(String, String)],
) -> String raise {
  let decls = []
  for input in inputs {
    let (file, source) = input
    for decl in read(file, source) {
      decls.push(decl)
    }
  }
  let code = generator.generate(decls)
  let names = inputs.map(i => base(i.0)).join(", ")
  "// Generated by \{generator.name()} from \{names}. Edit those files, not this one.\n\n" +
  code.to_string()
}

///|
fn base(path : String) -> String {
  match path.rev_find("/") {
    Some(i) => path[i + 1:].to_owned()
    None =>
      match path.rev_find("\\") {
        Some(i) => path[i + 1:].to_owned()
        None => path
      }
  }
}
