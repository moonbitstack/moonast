///|
/// `#demo.describe` on a struct gives it `describe`, which names the struct and
/// its fields: a derive small enough to read in one go.
struct Describe {}

///|
impl @gen.Generator for Describe with fn name(_) {
  "describe"
}

///|
impl @gen.Generator for Describe with fn generate(_, decls) {
  let out = []
  for decl in decls {
    guard decl is Struct(name~, fields~, attrs~, ..) &&
      @attr.find(attrs, "demo.describe") is Some(_) else {
      continue
    }
    let text = name + "(" + fields.map(f => f.name).join(", ") + ")"
    let source =
      #|fn $T::describe(self : $T) -> String {
      #|  ignore(self)
      #|  $text
      #|}
    out.push(
      @quote.items(source)
      .set("T", @quote.ident(name))
      .set("text", @quote.string(text))
      .render(),
    )
  }
  @quote.join(out)
}

///|
let models : String =
  #|#demo.describe
  #|pub struct Point {
  #|  x : Int
  #|  mut y : Array[Int]
  #|}
  #|
  #|pub enum Shape {
  #|  Circle
  #|  Square
  #|}
  #|
  #|#app.get("/a")
  #|async fn Point::fetch(self : Point, id~ : Int, limit? : Int, _ : String) -> Point? {
  #|  ignore((self, id, limit))
  #|  None
  #|}

///|
test "declarations read into views with their types as written" {
  let decls = @gen.read("models.mbt", models)
  guard decls
    is [
      Struct(name~, fields~, public~, ..),
      Enum(constructors~, ..),
      Func(owner~, name=fname, params~, returns~, is_async~, ..),
    ] else {
    fail("unexpected views")
  }
  assert_eq(name, "Point")
  assert_eq(public, true)
  assert_eq(fields.map(f => (f.name, f.ty, f.mutable)), [
    ("x", "Int", false),
    ("y", "Array[Int]", true),
  ])
  assert_eq(constructors, ["Circle", "Square"])
  assert_eq(owner, Some("Point"))
  assert_eq(fname, "fetch")
  assert_eq(params.map(p => (p.name, p.ty, p.pass)), [
    (Some("self"), Some("Point"), Positional),
    (Some("id"), Some("Int"), Labelled),
    (Some("limit"), Some("Int"), Optional),
    (None, Some("String"), Positional),
  ])
  assert_eq(returns, Some("Point?"))
  assert_eq(is_async, true)
  assert_eq(decls[2].attrs().iter().map(@attr.name_of).collect(), [
    Some("app.get"),
  ])
}

///|
test "a generator renders its code under a header naming it and its inputs" {
  let out = @gen.render(Describe::{ }, [("lib/models.mbt", models)])
  inspect(
    out,
    content=(
      #|// Generated by describe from models.mbt. Edit those files, not this one.
      #|
      #|///|
      #|fn Point::describe(self : Point) -> String {
      #|  ignore(self)
      #|  "Point(x, y)"
      #|}
      #|
    ),
  )
}

///|
test "an input that is not MoonBit is refused with its position" {
  let refused = try @gen.read("bad.mbt", "fn (") catch {
    e => Some(e)
  } noraise {
    _ => None
  }
  guard refused is Some(Syntax(file="bad.mbt", line=1, ..)) else {
    fail("a broken file reads")
  }
}

///|
/// A file with one of each body a generator has to tell apart.
let bodies : String =
  #|pub struct Point {
  #|  x : Int
  #|  nick : String?
  #|  seen : Option[Int]
  #|}
  #|
  #|pub struct Rgb(Int, Int, Int)
  #|
  #|pub struct Meters(Double)
  #|
  #|pub struct Marker {}
  #|
  #|pub enum Shape {
  #|  Empty
  #|  Circle(Double)
  #|  Rect(Double, Double)
  #|  Tagged(name~ : String, size~ : Int)
  #|}

///|
test "the view of a type's body covers every shape a type can have" {
  let shapes = @gen.read("bodies.mbt", bodies).map(decl => {
    match decl.shape() {
      None => "none"
      Some(Empty) => "empty"
      Some(Tuple(arity~)) => "tuple of \{arity}"
      Some(Record(fields~)) => "record of \{fields.length()}"
      Some(Cases(cases~)) => "cases of \{cases.length()}"
    }
  })
  assert_eq(shapes, [
    "record of 3", "tuple of 3", "tuple of 1", "empty", "cases of 4",
  ])
}

///|
test "a field says whether its type is Option, however it is written" {
  let decls = @gen.read("bodies.mbt", bodies)
  guard decls is [Struct(fields~, ..), ..] else { fail("a record") }
  assert_eq(fields.map(f => (f.name, f.optional)), [
    ("x", false),
    ("nick", true),
    ("seen", true),
  ])
}

///|
test "a variant says what it carries" {
  let decls = @gen.read("bodies.mbt", bodies)
  guard decls[4] is Enum(cases~, ..) else { fail("an enum") }
  let carried = cases.map(c => {
    match c.payload {
      Empty => "empty"
      Tuple(arity~) => "tuple of \{arity}"
      Record(fields~) =>
        "record of " + fields.map(f => f.name + ": " + f.ty).join(", ")
      Cases(_) => "cases"
    }
  })
  assert_eq(carried, [
    "empty", "tuple of 1", "tuple of 2", "record of name: String, size: Int",
  ])
}

///|
test "a tuple struct has a name and a visibility without a variant of its own" {
  let decls = @gen.read("bodies.mbt", bodies)
  guard decls[1] is Other(..) else { fail("a tuple struct is Other") }
  assert_eq(decls[1].name(), "Rgb")
  assert_eq(decls[1].is_public(), true)
  assert_eq(@attr.find(decls[1].attrs(), "demo.describe") is None, true)
}

///|
test "a generic type keeps its parameters" {
  let decls = @gen.read("m.mbt", "pub struct Pair[A, B] {\n  first : A\n}")
  assert_eq(decls[0].params(), ["A", "B"])
}

///|
/// A file whose declarations the view has no variant for: each one carries its
/// own annotations.
let annotated_others : String =
  #|#demo.track
  #|let counter : Int = 0
  #|
  #|#demo.track
  #|impl Show for Point with fn output(self, logger) {
  #|  logger.write_string("")
  #|}
  #|
  #|#demo.track
  #|pub trait Named {
  #|  name(Self) -> String
  #|}

///|
test "an annotation on a top-level let is read off its own node" {
  guard @gen.read("m.mbt", annotated_others) is [decl, ..] else {
    fail("declarations")
  }
  guard decl is Other(..) else { fail("a let is Other") }
  assert_eq(decl.attrs().iter().map(@attr.name_of).collect(), [
    Some("demo.track"),
  ])
}

///|
test "an annotation on an impl is read off its own node" {
  let decls = @gen.read("m.mbt", annotated_others)
  guard decls is [_, decl, ..] else { fail("declarations") }
  guard decl is Other(..) else { fail("an impl is Other") }
  assert_eq(decl.attrs().iter().map(@attr.name_of).collect(), [
    Some("demo.track"),
  ])
}

///|
test "an annotation on a trait is read off its own node" {
  let decls = @gen.read("m.mbt", annotated_others)
  guard decls is [_, _, decl] else { fail("declarations") }
  guard decl is Other(..) else { fail("a trait is Other") }
  assert_eq(decl.attrs().iter().map(@attr.name_of).collect(), [
    Some("demo.track"),
  ])
  assert_eq(decl.name(), "Named")
  assert_eq(decl.is_public(), true)
}

///|
test "a declaration says which file it came from" {
  let decls = @gen.read("src/models.mbt", models)
  assert_eq(decls.map(decl => decl.file()), [
    "src/models.mbt", "src/models.mbt", "src/models.mbt",
  ])
}

///|
test "a refusal about an annotation names the file the declaration came from" {
  let source = "#demo.getters\npub struct User {\n  id : Int\n}"
  guard @gen.read("src/models.mbt", source) is [decl] else {
    fail("one declaration")
  }
  guard @attr.find(decl.attrs(), "demo.getters") is Some(annotation) else {
    fail("annotated")
  }
  let refused = try {
    let _ = @attr.Spec::new("demo.getters")
      .required("path", Str)
      .bind(annotation, file=decl.file())
    "bound"
  } catch {
    e => e.to_string()
  }
  assert_eq(refused, "src/models.mbt:1:1: path is required")
}
