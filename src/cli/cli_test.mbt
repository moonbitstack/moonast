///|
/// Writes one function per input struct, so a run's effect is easy to see.
struct Names {}

///|
impl @gen.Generator for Names with fn name(_) {
  "names"
}

///|
impl @gen.Generator for Names with fn generate(_, decls) {
  let names = decls.filter_map(d => {
    match d {
      Struct(name~, ..) => Some(@quote.string(name))
      _ => None
    }
  })
  @quote.items("fn struct_names() -> Array[String] { [$names*] }")
  .splice("names", names)
  .render()
}

///|
async test "a run writes the output, a check passes, and a changed input is stale" {
  let dir = @fs.tmpdir(prefix="moonast-cli")
  defer @fs.rmdir(dir, recursive=true)
  let input = dir + "/models.mbt"
  let output = dir + "/names.g.mbt"
  @fs.write_file(
    input, "struct A {\n  x : Int\n}\n\nstruct B {\n  y : Int\n}\n",
  )
  @cli.run(Names::{ }, [input, "-o", output])
  inspect(
    @fs.read_file(output).text(),
    content=(
      #|// Generated by names from models.mbt. Edit those files, not this one.
      #|
      #|///|
      #|fn struct_names() -> Array[String] {
      #|  ["A", "B"]
      #|}
      #|
    ),
  )
  @cli.run(Names::{ }, [input, "-o", output, "--check"])
  @fs.write_file(input, "struct C {\n  z : Int\n}\n")
  let stale = try @cli.run(Names::{ }, [input, "-o", output, "--check"]) catch {
    e => Some(e)
  } noraise {
    _ => None
  }
  guard stale is Some(@cli.Stale(..)) else {
    fail("a stale output passes the check")
  }
}

///|
async test "a check reads through a checkout that turned line feeds into CRLF" {
  let dir = @fs.tmpdir(prefix="moonast-cli-crlf")
  defer @fs.rmdir(dir, recursive=true)
  let input = dir + "/models.mbt"
  let output = dir + "/names.g.mbt"
  @fs.write_file(input, "struct A {\r\n  x : Int\r\n}\r\n")
  @cli.run(Names::{ }, [input, "-o", output])
  let crlf = @fs.read_file(output).text().replace_all(old="\n", new="\r\n")
  @fs.write_file(output, crlf)
  @cli.run(Names::{ }, [input, "-o", output, "--check"])
}

///|
async test "a malformed command line is refused before anything is read" {
  for
    args in [
      ["a.mbt"],
      ["-o", "out.mbt"],
      ["a.mbt", "-o"],
      ["a.mbt", "-o", "x", "-o", "y"],
      ["a.mbt", "-o", "x", "--fast"],
    ] {
    let refused = try @cli.run(Names::{ }, args) catch {
      e => Some(e)
    } noraise {
      _ => None
    }
    guard refused is Some(@cli.Usage(..)) else {
      fail("a malformed command line is accepted")
    }
  }
}

///|
async test "relative paths resolve against -C, the way a dev_build rule passes them" {
  let dir = @fs.tmpdir(prefix="moonast-cli-dir")
  defer @fs.rmdir(dir, recursive=true)
  @fs.write_file(dir + "/models.mbt", "struct A {\n  x : Int\n}\n")
  @cli.run(Names::{ }, ["-C", dir, "models.mbt", "-o", "out.g.mbt"])
  assert_true(@fs.read_file(dir + "/out.g.mbt").text().contains("[\"A\"]"))
}
