name = "moonbitstack/moonast"

version = "0.2.6"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonast"

license = "Apache-2.0"

keywords = [
  "codegen",
  "code-generation",
  "code-generator",
  "source-generation",
  "proc-macro",
  "derive-macro",
  "annotation-processor",
  "ast",
  "macro",
  "macros",
  "derive",
  "attribute",
  "attributes",
  "annotation",
  "annotations",
  "metaprogramming",
  "quote",
  "syntax-tree",
  "parser",
  "moonbit",
]

description = "Code generation for MoonBit from annotated declarations."

import {
  "moonbitlang/parser@0.4.7",
  "moonbitlang/async@0.22.5",
}

source = "src"
