///|
/// `#demo.describe` on a struct gives it `describe`, which names the struct and
/// its fields: a derive small enough to read in one go.
struct Describe {}

///|
impl @gen.Generator for Describe with fn name(_) {
  "describe"
}

///|
impl @gen.Generator for Describe with fn generate(_, decls) {
  let out = []
  for decl in decls {
    guard decl is Struct(name~, fields~, attrs~, ..) &&
      @attr.find(attrs, "demo.describe") is Some(_) else {
      continue
    }
    let text = name + "(" + fields.map(f => f.name).join(", ") + ")"
    let source =
      #|fn $T::describe(self : $T) -> String {
      #|  ignore(self)
      #|  $text
      #|}
    out.push(
      @quote.items(source)
      .set("T", @quote.ident(name))
      .set("text", @quote.string(text))
      .render(),
    )
  }
  @quote.join(out)
}

///|
let models : String =
  #|#demo.describe
  #|pub struct Point {
  #|  x : Int
  #|  mut y : Array[Int]
  #|}
  #|
  #|pub enum Shape {
  #|  Circle
  #|  Square
  #|}
  #|
  #|#app.get("/a")
  #|async fn Point::fetch(self : Point, id~ : Int, limit? : Int, _ : String) -> Point? {
  #|  ignore((self, id, limit))
  #|  None
  #|}

///|
test "declarations read into views with their types as written" {
  let decls = @gen.read("models.mbt", models)
  guard decls
    is [
      Struct(name~, fields~, public~, ..),
      Enum(constructors~, ..),
      Func(owner~, name=fname, params~, returns~, is_async~, ..),
    ] else {
    fail("unexpected views")
  }
  assert_eq(name, "Point")
  assert_eq(public, true)
  assert_eq(fields.map(f => (f.name, f.ty, f.mutable)), [
    ("x", "Int", false),
    ("y", "Array[Int]", true),
  ])
  assert_eq(constructors, ["Circle", "Square"])
  assert_eq(owner, Some("Point"))
  assert_eq(fname, "fetch")
  assert_eq(params.map(p => (p.name, p.ty, p.pass)), [
    (Some("self"), Some("Point"), Positional),
    (Some("id"), Some("Int"), Labelled),
    (Some("limit"), Some("Int"), Optional),
    (None, Some("String"), Positional),
  ])
  assert_eq(returns, Some("Point?"))
  assert_eq(is_async, true)
  assert_eq(decls[2].attrs().iter().map(@attr.name_of).collect(), [
    Some("app.get"),
  ])
}

///|
test "a generator renders its code under a header naming it and its inputs" {
  let out = @gen.render(Describe::{ }, [("lib/models.mbt", models)])
  inspect(
    out,
    content=(
      #|// Generated by describe from models.mbt. Edit those files, not this one.
      #|
      #|///|
      #|fn Point::describe(self : Point) -> String {
      #|  ignore(self)
      #|  "Point(x, y)"
      #|}
      #|
    ),
  )
}

///|
test "an input that is not MoonBit is refused with its position" {
  let refused = try @gen.read("bad.mbt", "fn (") catch {
    e => Some(e)
  } noraise {
    _ => None
  }
  guard refused is Some(Syntax(file="bad.mbt", line=1, ..)) else {
    fail("a broken file reads")
  }
}
